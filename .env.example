# App
APP_URL=http://localhost:8080
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database
# Leave unset for local in-memory PGLite preview. Set for production Postgres/Neon.
DATABASE_URL=postgresql://user:password@host:5432/order

# OAuth broker / provider credentials, optional when using only email-password locally.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Stripe checkout. Access is activated only from server-side confirmation/webhook/admin grant.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Storage abstraction
STORAGE_PROVIDER=local
PRIVATE_UPLOAD_ROOT=storage/private
MAX_UPLOAD_MB=10

# Email integration placeholders
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_URL=

# Admin bootstrap
# The local dev fallback user is an admin when auth is disabled/no DATABASE_URL.
ADMIN_EMAILS=admin@example.com
